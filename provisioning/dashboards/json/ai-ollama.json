          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Installed Models",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "Size",
              "model": "Model",
              "family": "Family",
              "parameters": "Parameters",
              "quantization": "Quantization"
            }
          }
        }
